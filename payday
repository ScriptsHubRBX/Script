local function getPosition(target)
    if typeof(target) == "Vector3" then
        return target
    elseif typeof(target) == "Instance" then
        if target:IsA("Model") then
            local primary = target:FindFirstChild("HumanoidRootPart")
                or target:FindFirstChild("PrimaryPart")
                or target:FindFirstChildWhichIsA("BasePart")
            if primary then return primary.Position end
        elseif target:IsA("BasePart") then
            return target.Position
        end
    end
    return nil
end

local function moveTo(targetPos, moveSpeed)
    local dist = 1
    if character.Humanoid.Sit == true then
        dist = 5
    end
    repeat
        task.wait()
        local direction = (targetPos - hrp.Position).Unit
        bv.Velocity = direction * moveSpeed
    until (targetPos - hrp.Position).Magnitude <= dist
    bv.Velocity = Vector3.zero
end

local function findNearest(items, visited)
    local nearest, nearestPos, minDist = nil, nil, math.huge
    for _, v in items do
        if not visited[v] and v.Name ~= "WeaponBagger" then
            local pos = getPosition(v:FindFirstChild("Hitbox") or v)
            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = v
                    nearestPos = pos
                end
            end
        end
    end
    return nearest, nearestPos,v
end

-- Ждём пока объект удалится из Workspace (с таймаутом)
local function waitForRemoval(target)
    repeat
        for i, v in target:GetChildren() do
            if v:FindFirstChild("ProximityPrompt")  then
                StartInteraction:FireServer(v:FindFirstChild("ProximityPrompt"))
                if target.Name == "WeaponBagger" then
                    task.wait(1)
                else
                    task.wait(.51)
                end
                CompleteInteraction:FireServer(v:FindFirstChild("ProximityPrompt"))
                break
            end
        end
    until not target or not target.Parent
end

