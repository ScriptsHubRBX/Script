local function deserialize(b)
  local base64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
  local result = ""
  local i = 1
  
  while i <= #b do
    local c1 = string.find(base64chars, string.sub(b,i,i))-1
    local c2 = string.find(base64chars, string.sub(b,i+1,i+1))-1
    local c3 = string.find(base64chars, string.sub(b,i+2,i+2))-1
    local c4 = string.find(base64chars, string.sub(b,i+3,i+3))-1
    
    result = result..string.char(bit32.lshift(c1, 2) + bit32.rshift(c2, 4))
    
    if c3 ~= -1 then
      result = result..string.char(bit32.lshift(bit32.band(c2, 0xF), 4) + bit32.rshift(c3, 2))
      if c4 ~= -1 then
        result = result..string.char(bit32.lshift(bit32.band(c3, 0x3), 6) + c4)
      end
    end
    
    i = i + 4
  end
  
  return result
end

local moonlight_map = {0,1}
local moonlight_chunks = {"cHJpbnQ","oMSk="}
local moonlight_code = ""

for i = 1, #moonlight_map do
  local idx = moonlight_map[i]
  moonlight_code = moonlight_code..moonlight_chunks[i]
end

loadstring(deserialize(moonlight_code))()
